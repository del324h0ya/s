# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_TELEGRAM_ID=YOUR_ADMIN_TELEGRAM_ID

# Telegram webhook / Belmo
BELMO_PUBLIC_URL=https://YOUR-BELMO-DOMAIN
TELEGRAM_WEBHOOK_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET

# GoldAPI.io — XAU/USD live price
GOLDAPI_API_KEY=YOUR_GOLDAPI_API_KEY

# Production database (Neon PostgreSQL)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REQUIRE_POSTGRES=1
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=10

# Whop Phase 2
WHOP_COMPANY_API_KEY=YOUR_WHOP_COMPANY_API_KEY
WHOP_COMPANY_ID=YOUR_WHOP_COMPANY_ID
WHOP_WEBHOOK_SECRET=YOUR_WHOP_WEBHOOK_SECRET

# Error monitoring
SENTRY_DSN=YOUR_SENTRY_DSN
SENTRY_ENVIRONMENT=production

# Logging
LOG_LEVEL=INFO
